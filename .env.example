# ==========================================
# ClipForge - Environment Configuration Template
# ==========================================

# --- APPLICATION & SECURITY ---
PROJECT_NAME="ClipForge"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- DATABASE ---
# Local SQLite default (no setup needed):
DATABASE_URL="sqlite:///./clipforge.db"
# Production PostgreSQL:
# DATABASE_URL="postgresql://clipforge_user:clipforge_password@localhost:5432/clipforge_db"
POSTGRES_USER=clipforge_user
POSTGRES_PASSWORD=clipforge_password
POSTGRES_DB=clipforge_db

# --- CELERY & REDIS QUEUE ---
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# --- STORAGE ADAPTER ---
# Choose "local" for dev or "s3" for Cloudflare R2 / AWS S3
STORAGE_TYPE="local"
LOCAL_STORAGE_DIR="./storage_data"

# S3 / Cloudflare R2 Credentials (if STORAGE_TYPE="s3")
S3_ENDPOINT_URL=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="clipforge-media"
S3_REGION="auto"

# --- LLM HIGHLIGHT & VIRALITY PROVIDER ---
# "gemini" or "claude"
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# --- AUTH & OAUTH (NextAuth / Google) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- FRONTEND CLIENT ---
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
